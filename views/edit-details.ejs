</head>
<body>
    <h1>edit makeup</h1>
    <form action="/makeup/<%= makeup._id%>?_method=PUT" method="post">
        <label for="name">Name:</label>
        <input value="<%= makeup.name  %>" name="name" id="name" type="text">
        
         <label for="isAvailable">Is Available?</label>
        <input <% if (makeup.isAvailable){%> cheaked<%} %> name="isAvailable" id="isAvailable" type="checkbox">
        <button>Create makeup</button>
    </form>
</body>
</html>